# Port to listen on (default is 8085)
PROXY_PORT=8085

# Where .env / usage.json / proxy.log live. Defaults to the folder next to
# server.js in a git checkout, or ~/.config/opencode-gemini-proxy when
# installed via npm/npx. Usually you don't need to set this — Docker sets
# it to /app/data automatically (see docker-compose.yml).
# PROXY_DATA_DIR=/custom/path

# Google AI Studio API Keys — get one free at https://aistudio.google.com/apikey
# You can define multiple keys to multiply your rate limits and throughput!
# (You can also add/remove keys later from the dashboard at http://localhost:8085
# without touching this file — it gets rewritten for you.)
GOOGLE_API_KEY_1=your_first_google_api_key_here
GOOGLE_API_KEY_2=your_second_google_api_key_here
# GOOGLE_API_KEY_3=your_third_google_api_key_here

# Optional: comma-separated subset/order of models to use for failover.
# Leave unset to use all supported models. Also editable from the dashboard.
# GOOGLE_ENABLED_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# When every model and key is rate-limited, hold the request open until quota
# comes back instead of returning 429 (which makes OpenCode abort the run).
# The held request is kept alive with SSE keepalives, so a long agent run can
# survive a daily-quota wall and resume by itself after the reset.
# PROXY_WAIT_FOR_QUOTA=true       # set to "false" for the old fail-fast 429
# PROXY_MAX_WAIT_HOURS=24         # give up after this long (default 24)

# Upstream timeouts (ms). TTFT = how long to wait for Google's response headers
# before aborting the attempt and failing over; IDLE = max gap between stream
# chunks. Raise TTFT if big-context prompts get aborted right before the first
# token (shows up in proxy.log as "This operation was aborted" ~TTFT after the request).
# PROXY_TTFT_MS=30000
# PROXY_IDLE_MS=45000
# PROXY_TOTAL_ATTEMPT_MS=120000
# PROXY_REQUEST_BUDGET_MS=180000

# Shows failover/wait status inside OpenCode's dim "thinking" block via
# reasoning_content, so you can see what the proxy is doing with zero client
# setup. "content" writes it into the visible answer text instead; "off" disables.
# PROXY_STATUS=reasoning          # reasoning | content | off

# Skip validating a new key against Google before adding it (POST /api/keys
# normally does a quick live check). Useful offline or in tests.
# PROXY_SKIP_KEY_CHECK=true

# How often (hours) the proxy checks Google's model list for new/retired
# Gemini models. 0 disables the recurring check (it still runs once ~3s
# after startup, and after a key is added).
# PROXY_DISCOVERY_HOURS=6

# Auto-enable newly discovered models instead of leaving them unchecked in
# the dashboard. WARNING: this changes your failover cascade without asking —
# leave it off unless you want that.
# PROXY_AUTO_ENABLE_NEW_MODELS=false

# Host to bind to (default 127.0.0.1 / loopback-only). Binding to anything
# else (e.g. 0.0.0.0 to reach the dashboard from another device) REQUIRES
# PROXY_ADMIN_TOKEN below, or the proxy refuses to start.
# PROXY_HOST=127.0.0.1
# PROXY_ADMIN_TOKEN=some-long-random-string   # required if PROXY_HOST is not loopback; guards /api/* and /metrics (Authorization: Bearer <token>, or ?token= for /api/events)
