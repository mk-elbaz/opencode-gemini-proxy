# Port to listen on (default is 8085)
PROXY_PORT=8085

# Google AI Studio API Keys — get one free at https://aistudio.google.com/apikey
# You can define multiple keys to multiply your rate limits and throughput!
# (You can also add/remove keys later from the dashboard at http://localhost:8085
# without touching this file — it gets rewritten for you.)
GOOGLE_API_KEY_1=your_first_google_api_key_here
GOOGLE_API_KEY_2=your_second_google_api_key_here
# GOOGLE_API_KEY_3=your_third_google_api_key_here

# Optional: comma-separated subset/order of models to use for failover.
# Leave unset to use all supported models. Also editable from the dashboard.
# GOOGLE_ENABLED_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# When every model and key is rate-limited, hold the request open until quota
# comes back instead of returning 429 (which makes OpenCode abort the run).
# The held request is kept alive with SSE keepalives, so a long agent run can
# survive a daily-quota wall and resume by itself after the reset.
# PROXY_WAIT_FOR_QUOTA=true       # set to "false" for the old fail-fast 429
# PROXY_MAX_WAIT_HOURS=24         # give up after this long (default 24)
