{
  "name": "opencode-gemini-proxy",
  "version": "1.0.0",
  "description": "Zero-dependency OpenAI-compatible proxy for Google Gemini with auto-failover, multi-key rotation, and OpenCode subagent support",
  "type": "module",
  "main": "server.js",
  "bin": {
    "opencode-gemini-proxy": "cli.js"
  },
  "files": [
    "server.js",
    "cli.js",
    "paths.js",
    "compat.js",
    "quota.js",
    "status.js",
    "discovery.js",
    "dashboard/",
    "opencode-plugin/",
    ".env.example",
    "README.md",
    "LICENSE",
    "watchdog.sh",
    "watchdog.vbs",
    "start.bat"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test"
  },
  "keywords": [
    "opencode",
    "gemini",
    "google-ai-studio",
    "proxy",
    "openai-compatible",
    "rate-limit",
    "failover",
    "load-balancer"
  ],
  "author": "mk-elbaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mk-elbaz/opencode-gemini-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/mk-elbaz/opencode-gemini-proxy/issues"
  },
  "homepage": "https://github.com/mk-elbaz/opencode-gemini-proxy#readme"
}
